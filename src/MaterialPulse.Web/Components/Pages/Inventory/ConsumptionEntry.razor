@page "/inventory/entry"
@rendermode InteractiveServer
@inject IInventoryService Service

<PageTitle>Stock Entry</PageTitle>

<h3>Record Stock Movement</h3>

@if (materials is null)
{
    <p>Loading...</p>
}
else
{
    <div class="col-md-6">
        <div class="mb-3">
            <label class="form-label">Type</label>
            <select class="form-select" @bind="type">
                <option value="@TransactionType.StockIn">Stock In</option>
                <option value="@TransactionType.Consumption">Consumption</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Material</label>
            <select class="form-select" @bind="materialId">
                <option value="0">-- Select material --</option>
                @foreach (var m in materials)
                {
                    <option value="@m.Id">@m.Name</option>
                }
            </select>
            @if (selected is not null)
            {
                <div class="form-text">Available: @selected.CurrentStock.ToString("N2") @selected.Unit</div>
            }
        </div>

        <div class="mb-3">
            <label class="form-label">Quantity</label>
            <input type="number" step="0.001" class="form-control" @bind="quantity" />
        </div>

        <div class="mb-3">
            <label class="form-label">@(type == TransactionType.StockIn ? "Source" : "Destination")</label>
            <input type="text" class="form-control" @bind="note" />
        </div>

        <button class="btn btn-primary" @onclick="SaveAsync">Save</button>

        @if (message is not null)
        {
            <div class="alert @(isError ? "alert-danger" : "alert-success") mt-3">@message</div>
        }
    </div>
}

@code {
    private List<StockItemDto>? materials;
    private int materialId;
    private TransactionType type = TransactionType.StockIn;
    private decimal quantity;
    private string? note;
    private string? message;
    private bool isError;

    private StockItemDto? selected => materials?.FirstOrDefault(m => m.Id == materialId);

    protected override async Task OnInitializedAsync()
    {
        materials = await Service.GetStockListAsync();
    }

    private async Task SaveAsync()
    {
        try
        {
            if (materialId == 0)
            {
                throw new InvalidOperationException("Please select a material.");
            }

            if (type == TransactionType.StockIn)
            {
                await Service.RecordStockInAsync(materialId, quantity, note, null);
            }
            else
            {
                await Service.RecordConsumptionAsync(materialId, quantity, note, null);
            }

            materials = await Service.GetStockListAsync();
            message = "Saved successfully.";
            isError = false;
            quantity = 0;
            note = null;
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            message = ex.Message;
            isError = true;
        }
    }
}